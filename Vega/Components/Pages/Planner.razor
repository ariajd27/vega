@page "/planner"
@attribute [StreamRendering]
@rendermode InteractiveServer
@using System.Text.Json
@using System.ComponentModel.DataAnnotations
@using Vega.Models
@using Vega.Calculator
@using Listing = Vega.Components.Elements.ListingInput.TinyListing
@using Term = Vega.Components.Elements.TermInput.Term
@inject VegaService VegaService
@inject IJSRuntime JSRuntime

<PageTitle>Planner</PageTitle>

<div class="page_body_field">

    <h1>Degree Planner</h1>

    <p>This page is still under construction. Consider trying out the catalog search!</p>

</div>

<CookieDisclaimer />

<CollapsibleHeader @bind-IsExpanded="backgroundExpanded">

    <HeaderContent>
        Previous Courses
    </HeaderContent>

    <ChildContent>

        <p>
            Enter any previous courses you have Pitt credit for here. 
            Alternatively, save time by <a href="planner/import">importing your unofficial transcript from PeopleSoft</a>.
        </p>

        <EditForm Model="Background" OnSubmit="SubmitBackground" FormName="BackgroundForm">

             <DataAnnotationsValidator />
             <ul class="form">
                <li>
                    <span>Courses:</span>
                    @if (subjects != null)
                    {
                        <InputListings Subjects="subjects" @bind-Listings="Background.Listings" />
                    }
                    else
                    {
                        <emph> loading...</emph>
                    }
                </li>
                <li>
                    <button type="submit">Update</button>
                </li>
            </ul>
            <ValidationSummary />

        </EditForm>

    </ChildContent>

</CollapsibleHeader>

<CollapsibleHeader @bind-IsExpanded="todoExpanded">

    <HeaderContent>
        Future Courses
    </HeaderContent>

    <ChildContent>

        <p>
            Enter all courses you need to take before you graduate here.
        </p>

        <EditForm Model="Todo" OnSubmit="SubmitTodo" FormName="TodoForm">

            <DataAnnotationsValidator />
            <ul class="form">
                <li>
                    <span>Courses:</span>
                    @if (subjects != null)
                    {
                        <InputListings Subjects="subjects" @bind-Listings="Todo.Listings" />
                    }
                    else
                    {
                        <emph> loading...</emph>
                    }
                </li>
                <li>
                    <button type="submit">Update</button>
                </li>
            </ul>
            <ValidationSummary />

        </EditForm>

    </ChildContent>

</CollapsibleHeader>

<CollapsibleHeader @bind-IsExpanded="calculatorExpanded">

    <HeaderContent>
        Calculator
    </HeaderContent>

    <ChildContent>

        <EditForm Model="Settings" OnSubmit="Calculate" FormName="CalculatorForm">

            <ul class="form">

                <li>
                    First term to output a plan for:
                    <TermInput @bind-Value="Settings.FirstTerm" />
                </li>

                <li>
                    Expected graduation:
                    <TermInput @bind-Value="Settings.LastTerm" />
                </li>

                <li>
                    Maximum credit load per regular term (more than 18 means overload):
                    <InputNumber @bind-Value="Settings.TermCreditMax" />
                </li>

                <li>
                    Minimum credit load per term (12 or more for full-time):
                    <InputNumber @bind-Value="Settings.TermCreditMin" />
                </li>

                <li>
                    Maximum credit load per summer term (pay-per-credit):
                    <InputNumber @bind-Value="Settings.SummerCreditMax" />
                </li>

            </ul>

        </EditForm>

        <span>
            Check to make sure eveything is correct, then
            <button type="submit">Calculate!</button>
        </span>

        @if (plan != null)
        {
            <h2>Calculated Plan</h2>

            <ul class="list">
                @foreach (var term in plan)
                {
                    <li>
                        @term.Name
                        <ul class="list">
                            @foreach (var course in term.Courses)
                            {
                                <li>
                                    @course.Name
                                </li>
                            }
                        </ul>
                    </li>
                }
            </ul>
        }

    </ChildContent>

</CollapsibleHeader>

@code {
    [SupplyParameterFromForm] private BackgroundType Background { get; set; } = new();
    [SupplyParameterFromForm] private TodoType Todo { get; set; } = new();
    [SupplyParameterFromForm] private SettingsType Settings { get; set; } = new();

    private bool backgroundExpanded = true;
    private bool todoExpanded = true;
    private bool calculatorExpanded = true;

    private IEnumerable<Vega.Calculator.Term>? plan;

    private string[]? subjects;

    public static readonly string backgroundListingsCookieKey = "backgroundListings";
    public static readonly string backgroundCoursesCookieKey = "backgroundCourses";
    public static readonly string todoListingsCookieKey = "todoListings";
    public static readonly string todoCoursesCookieKey = "todoCourses";
    public static readonly string campusCookieKey = "campus";

    protected override void OnInitialized()
    {
        Background = new();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dbSubjects = await VegaService.GetSubjectsAsync();
            subjects = dbSubjects.Select(s => s.Name).ToArray();
            StateHasChanged();

            if (Background.Listings.Count == 0) await LoadCookiesAsync();
        }
    }

    private async Task LoadCookiesAsync()
    {
        var cookieResponse = await JSRuntime.InvokeAsync<string>("cookies.get", backgroundListingsCookieKey);
        if (!string.IsNullOrEmpty(cookieResponse))
        {
            var cookieListings = JsonSerializer.Deserialize<Listing[]>(cookieResponse);
            if (cookieListings != null) Background.Listings.AddRange(cookieListings);
        }

        cookieResponse = await JSRuntime.InvokeAsync<string>("cookies.get", todoListingsCookieKey);
        if (!string.IsNullOrEmpty(cookieResponse))
        {
            var cookieListings = JsonSerializer.Deserialize<Listing[]>(cookieResponse);
            if (cookieListings != null) Todo.Listings.AddRange(cookieListings);
        }

        StateHasChanged();
    }

    private async Task SetCookiesAsync()
    {
        await JSRuntime.InvokeVoidAsync("cookies.set", backgroundListingsCookieKey, JsonSerializer.Serialize(Background.Listings));
        await JSRuntime.InvokeVoidAsync("cookies.set", backgroundCoursesCookieKey, JsonSerializer.Serialize(GetCourses(Background.Listings)));
        await JSRuntime.InvokeVoidAsync("cookies.set", todoListingsCookieKey, JsonSerializer.Serialize(Todo.Listings));
        await JSRuntime.InvokeVoidAsync("cookies.set", todoCoursesCookieKey, JsonSerializer.Serialize(GetCourses(Todo.Listings)));
    }

    private async Task<IEnumerable<int>> GetCourses(IEnumerable<Listing> listings)
    {
        var courses = await Task.WhenAll(listings.Select(async l => await VegaService.GetCourseByListingAsync(l.Subject, l.Number)));
        return courses.Where(c => c != null).Select(c => c!.Id).ToArray();
    }

    private async Task SubmitBackground()
    {
        backgroundExpanded = false;
        todoExpanded = true;
        await SetCookiesAsync();
    }

    private async Task SubmitTodo()
    {
        await SetCookiesAsync();
    }

    private class BackgroundType()
    {
        public List<Listing> Listings { get; set; } = [];
    }

    private class TodoType()
    {
        public List<Listing> Listings { get; set; } = [];
    }

    private class SettingsType()
    {
        [Required] public Term FirstTerm { get; set; } = new();
        [Required] public Term LastTerm { get; set; } = new();

        public int TermCreditMax { get; set; } = 16;
        public int TermCreditMin { get; set; } = 12;
        public int SummerCreditMax { get; set; } = 0;
    }

    private async Task Calculate()
    {
        var pastCourses = await GetCourses(Background.Listings);
        var terms = Term.Range(Settings.FirstTerm, Settings.LastTerm);

        Calculator calculator = new(VegaService, terms, pastCourses);
        await calculator.Calculate(subjects!, Todo.Listings.Select(l => (l.Subject, l.Number)));
        plan = calculator.GetTerms();

        StateHasChanged();
    }
}